{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocomposer.local/config.schema.json",
  "title": "GeoComposer config",
  "description": "Schema for the resolved GeoComposer configuration validated after EnvSolver and DefsSolver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "services",
    "sources",
    "layers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "services": {
      "$ref": "#/$defs/services"
    },
    "tilesets": {
      "$ref": "#/$defs/tilesets"
    },
    "projections": {
      "$ref": "#/$defs/projections"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "styles": {
      "$ref": "#/$defs/styles"
    },
    "layers": {
      "$ref": "#/$defs/layers"
    }
  },
  "$defs": {
    "httpPath": {
      "title": "HTTP path",
      "type": "string",
      "pattern": "^/"
    },
    "describedEntry": {
      "title": "Common descriptive fields",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        }
      }
    },
    "serviceInfo": {
      "title": "Common service fields",
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/httpPath"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "onlineResource": {
          "type": "string"
        }
      }
    },
    "bbox": {
      "title": "Bounding box",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "DEBUG",
            "LOG",
            "WARN",
            "ERROR",
            "NONE"
          ]
        }
      }
    },
    "services": {
      "title": "Enabled services",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "wms": {
          "$ref": "#/$defs/wmsService"
        },
        "api": {
          "$ref": "#/$defs/ogcFeaturesService"
        },
        "xyz": {
          "$ref": "#/$defs/xyzService"
        },
        "wmts": {
          "$ref": "#/$defs/wmtsService"
        }
      }
    },
    "wmsService": {
      "title": "WMS service",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/serviceInfo"
        }
      ],
      "required": [
        "title"
      ],
      "properties": {
        "maxWidth": {
          "type": "integer",
          "minimum": 1
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 1
        },
        "supportedCrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "unevaluatedProperties": false
    },
    "ogcFeaturesService": {
      "title": "OGC API Features service",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/serviceInfo"
        }
      ],
      "required": [
        "title"
      ],
      "properties": {
        "defaultLimit": {
          "type": "integer",
          "minimum": 1
        },
        "maxLimit": {
          "type": "integer",
          "minimum": 1
        },
        "supportedCrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "unevaluatedProperties": false
    },
    "xyzService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/httpPath"
        },
        "maxScaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cache": {
          "type": "string"
        },
        "tilesets": {
          "$ref": "#/$defs/tilesetRefs"
        }
      }
    },
    "wmtsService": {
      "title": "WMTS service",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/serviceInfo"
        }
      ],
      "required": [
        "title"
      ],
      "properties": {
        "cache": {
          "type": "string"
        },
        "tilesets": {
          "$ref": "#/$defs/tilesetRefs"
        }
      },
      "unevaluatedProperties": false
    },
    "tilesetRefs": {
      "title": "Tileset name list",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tilesets": {
      "title": "Tileset registry",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/tileset"
      }
    },
    "tileset": {
      "title": "Tileset",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "formats",
        "layers"
      ],
      "properties": {
        "tileMatrixSet": {
          "enum": [
            "WebMercatorQuad"
          ]
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "image/png",
              "application/geo+json",
              "application/vnd.mapbox-vector-tile"
            ]
          }
        },
        "tileSize": {
          "type": "integer",
          "minimum": 1
        },
        "minZoom": {
          "type": "integer",
          "minimum": 0
        },
        "maxZoom": {
          "type": "integer",
          "minimum": 0
        },
        "cacheControl": {
          "type": "string"
        },
        "vector": {
          "$ref": "#/$defs/vectorTileOptions"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/tilesetLayer"
              }
            ]
          }
        }
      },
      "unevaluatedProperties": false
    },
    "vectorTileOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extent": {
          "type": "integer",
          "minimum": 1
        },
        "buffer": {
          "type": "number",
          "minimum": 0
        },
        "generalization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "geojsonPrecision": {
          "type": "integer",
          "minimum": 0
        },
        "maxFeatures": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tilesetLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/projection"
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/geojsonSource"
        },
        {
          "$ref": "#/$defs/gmlSource"
        },
        {
          "$ref": "#/$defs/shpSource"
        },
        {
          "$ref": "#/$defs/gpkgSource"
        },
        {
          "$ref": "#/$defs/postgisSource"
        },
        {
          "$ref": "#/$defs/oracleSource"
        }
      ]
    },
    "geojsonSource": {
      "title": "GeoJSON source",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "geojson"
        },
        "path": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "highWaterMark": {
          "type": "integer",
          "minimum": 1
        }
      },
      "unevaluatedProperties": false
    },
    "gmlSource": {
      "title": "GML source",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "gml"
        },
        "path": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "highWaterMark": {
          "type": "integer",
          "minimum": 1
        },
        "featureElementNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometryPropertyNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "axisOrder": {
          "enum": [
            "auto",
            "xy",
            "yx"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "shpSource": {
      "title": "Shapefile source",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "shpPath",
        "dbfPath"
      ],
      "properties": {
        "type": {
          "const": "shp"
        },
        "shpPath": {
          "type": "string"
        },
        "dbfPath": {
          "type": "string"
        },
        "dbfEncoding": {
          "type": "string"
        },
        "highWaterMark": {
          "type": "integer",
          "minimum": 1
        }
      },
      "unevaluatedProperties": false
    },
    "gpkgSource": {
      "title": "GeoPackage source",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "path",
        "datasets"
      ],
      "properties": {
        "type": {
          "const": "gpkg"
        },
        "path": {
          "type": "string"
        },
        "datasets": {
          "$ref": "#/$defs/gpkgDatasets"
        }
      },
      "unevaluatedProperties": false
    },
    "gpkgDatasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/gpkgDataset"
      }
    },
    "gpkgDataset": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tableName": {
              "type": "string",
              "minLength": 1
            },
            "geometryColumn": {
              "type": "string",
              "minLength": 1
            },
            "primaryKey": {
              "type": "string",
              "minLength": 1
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "sqlDatasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sqlDataset"
      }
    },
    "sqlDataset": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "tableName": {
              "type": "string",
              "minLength": 1
            },
            "geometryColumn": {
              "type": "string",
              "minLength": 1
            },
            "primaryKey": {
              "type": "string",
              "minLength": 1
            },
            "srid": {
              "type": "integer",
              "minimum": 1
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "postgisSource": {
      "title": "PostGIS source",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "connection",
        "datasets"
      ],
      "properties": {
        "type": {
          "const": "postgis"
        },
        "connection": {
          "$ref": "#/$defs/postgisConnection"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "datasets": {
          "$ref": "#/$defs/sqlDatasets"
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1
        },
        "extentStrategy": {
          "enum": [
            "estimated",
            "exact",
            "none"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "postgisConnection": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connectionString": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "ssl": {
              "type": "boolean"
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "connectionTimeoutMillis": {
              "type": "integer",
              "minimum": 0
            },
            "idleTimeoutMillis": {
              "type": "integer",
              "minimum": 0
            },
            "statementTimeoutMillis": {
              "type": "integer",
              "minimum": 0
            },
            "queryTimeoutMillis": {
              "type": "integer",
              "minimum": 0
            },
            "applicationName": {
              "type": "string"
            }
          }
        }
      ]
    },
    "oracleSource": {
      "title": "Oracle source",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "connection",
        "datasets"
      ],
      "properties": {
        "type": {
          "const": "oracle"
        },
        "connection": {
          "$ref": "#/$defs/oracleConnection"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "datasets": {
          "$ref": "#/$defs/sqlDatasets"
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1
        },
        "extentStrategy": {
          "enum": [
            "metadata",
            "exact",
            "none"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "oracleConnectionString": {
      "title": "Oracle connection URI",
      "type": "string",
      "pattern": "^oracle://[^:@/]+:[^@/]+@[^/]+:[0-9]+/.+$"
    },
    "oracleConnection": {
      "anyOf": [
        {
          "$ref": "#/$defs/oracleConnectionString"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionString"
          ],
          "properties": {
            "connectionString": {
              "$ref": "#/$defs/oracleConnectionString"
            },
            "externalAuth": {
              "type": "boolean"
            },
            "homogeneous": {
              "type": "boolean"
            },
            "poolMin": {
              "type": "integer",
              "minimum": 0
            },
            "poolMax": {
              "type": "integer",
              "minimum": 1
            },
            "poolIncrement": {
              "type": "integer",
              "minimum": 1
            },
            "poolTimeout": {
              "type": "integer",
              "minimum": 0
            },
            "queueTimeout": {
              "type": "integer",
              "minimum": 0
            },
            "stmtCacheSize": {
              "type": "integer",
              "minimum": 0
            },
            "callTimeout": {
              "type": "integer",
              "minimum": 0
            },
            "walletLocation": {
              "type": "string"
            },
            "walletPassword": {
              "type": "string"
            },
            "configDir": {
              "type": "string"
            }
          }
        }
      ]
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/style"
      }
    },
    "style": {
      "oneOf": [
        {
          "$ref": "#/$defs/builtinStyle"
        },
        {
          "$ref": "#/$defs/dynamicStyle"
        }
      ]
    },
    "builtinStyle": {
      "title": "Builtin style",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "builtin"
        }
      },
      "unevaluatedProperties": false
    },
    "dynamicStyle": {
      "title": "Dynamic style file",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "dynamic"
        },
        "path": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/dynamicStyleOptions"
        }
      },
      "unevaluatedProperties": false
    },
    "dynamicStyleOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "units": {
          "enum": [
            "m",
            "dd"
          ]
        },
        "dotsPerInch": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/layer"
      }
    },
    "layer": {
      "title": "Layer",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/describedEntry"
        }
      ],
      "oneOf": [
        {
          "required": [
            "source",
            "crs"
          ],
          "not": {
            "required": [
              "layer"
            ]
          }
        },
        {
          "required": [
            "layer"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "dataset"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "crs": {
          "type": "string"
        },
        "extent": {
          "$ref": "#/$defs/bbox"
        },
        "style": {
          "type": "string"
        },
        "pointProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointPropertyPair"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "pointPropertyPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "description": "Property name of the x coordinate to reproject.",
          "type": "string"
        },
        "y": {
          "description": "Property name of the y coordinate to reproject.",
          "type": "string"
        },
        "crs": {
          "description": "CRS of the x/y properties. Defaults to the layer CRS.",
          "type": "string"
        }
      }
    }
  }
}
