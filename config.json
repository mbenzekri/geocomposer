{
    "$schema": "./config.schema.json",
    "server": {
        "port": 3000
    },
    "services": {
        "wms": {
            "path": "/wms",
            "title": "GeoComposer WMS",
            "abstract": "Minimal WMS server backed by the GeoComposer render pipeline.",
            "onlineResource": "http://localhost:3000/wms",
            "maxWidth": 4096,
            "maxHeight": 4096
        },
        "xyz": {
            "path": "/tiles",
            "maxScaleFactor": 4,
            "cache": "cache/xyz",
            "tilesets": [
                "world",
                "world-capitals",
                "world-mem",
                "world-mem-capitals",
                "world-gml",
                "world-gml-capitals",
                "world-shp",
                "world-shp-capitals",
                "world-gpkg",
                "world-gpkg-capitals"
            ]
        },
        "wmts": {
            "path": "/wmts",
            "title": "GeoComposer WMTS",
            "abstract": "WMTS service backed by GeoComposer tilesets.",
            "onlineResource": "http://localhost:3000/wmts",
            "cache": "cache/wmts",
            "tilesets": [
                "world",
                "world-capitals",
                "world-mem",
                "world-mem-capitals",
                "world-gml",
                "world-gml-capitals",
                "world-shp",
                "world-shp-capitals",
                "world-gpkg",
                "world-gpkg-capitals"
            ]
        }
    },
    "tilesets": {
        "world": {
            "title": "World",
            "abstract": "Tiles for world country boundaries from the GeoJSON source.",
            "tileMatrixSet": "WebMercatorQuad",
            "formats": ["image/png", "application/geo+json", "application/vnd.mapbox-vector-tile"],
            "tileSize": 256,
            "minZoom": 0,
            "maxZoom": 8,
            "cacheControl": "public, max-age=3600",
            "vector": {
                "extent": 4096,
                "buffer": 64,
                "generalization": {
                    "tolerance": 0.75
                },
                "geojsonPrecision": 3
            },
            "layers": [
                {
                    "layer": "world",
                    "style": "world"
                }
            ]
        },
        "world-capitals": {
            "title": "World and Capitals",
            "abstract": "Tiles combining GeoJSON country boundaries and capital city labels.",
            "tileMatrixSet": "WebMercatorQuad",
            "formats": ["image/png", "application/geo+json", "application/vnd.mapbox-vector-tile"],
            "tileSize": 256,
            "minZoom": 0,
            "maxZoom": 8,
            "cacheControl": "public, max-age=3600",
            "vector": {
                "extent": 4096,
                "buffer": 64,
                "generalization": {
                    "tolerance": 0.75
                },
                "geojsonPrecision": 3
            },
            "layers": [
                {
                    "layer": "world",
                    "style": "world"
                },
                {
                    "layer": "capitals",
                    "style": "capitals"
                }
            ]
        },
        "world-mem": {
            "title": "World Memory",
            "abstract": "Tiles for world country boundaries from the memory source.",
            "tileMatrixSet": "WebMercatorQuad",
            "formats": ["image/png", "application/geo+json", "application/vnd.mapbox-vector-tile"],
            "tileSize": 256,
            "minZoom": 0,
            "maxZoom": 8,
            "cacheControl": "public, max-age=3600",
            "vector": {
                "extent": 4096,
                "buffer": 64,
                "generalization": {
                    "tolerance": 0.75
                },
                "geojsonPrecision": 3
            },
            "layers": [
                {
                    "layer": "world-mem",
                    "style": "world"
                }
            ]
        },
        "world-mem-capitals": {
            "title": "World Memory and Capitals",
            "abstract": "Tiles combining memory-backed country boundaries and capital city labels.",
            "tileMatrixSet": "WebMercatorQuad",
            "formats": ["image/png", "application/geo+json", "application/vnd.mapbox-vector-tile"],
            "tileSize": 256,
            "minZoom": 0,
            "maxZoom": 8,
            "cacheControl": "public, max-age=3600",
            "vector": {
                "extent": 4096,
                "buffer": 64,
                "generalization": {
                    "tolerance": 0.75
                },
                "geojsonPrecision": 3
            },
            "layers": [
                {
                    "layer": "world-mem",
                    "style": "world"
                },
                {
                    "layer": "capitals",
                    "style": "capitals"
                }
            ]
        },
        "world-gml": {
            "title": "World GML",
