            },
            "layers": [
                {
                    "layer": "world-shp",
                    "style": "world"
                },
                {
                    "layer": "capitals",
                    "style": "capitals"
                }
            ]
        },
        "world-gpkg": {
            "title": "World GeoPackage",
            "abstract": "Tiles for world country boundaries from the GeoPackage source.",
            "tileMatrixSet": "WebMercatorQuad",
            "formats": ["image/png", "application/geo+json", "application/vnd.mapbox-vector-tile"],
            "tileSize": 256,
            "minZoom": 0,
            "maxZoom": 8,
            "cacheControl": "public, max-age=3600",
            "vector": {
                "extent": 4096,
                "buffer": 64,
                "generalization": {
                    "tolerance": 0.75
                },
                "geojsonPrecision": 3
            },
            "layers": [
                {
                    "layer": "world-gpkg",
                    "style": "world"
                }
            ]
        },
        "world-gpkg-capitals": {
            "title": "World GeoPackage and Capitals",
            "abstract": "Tiles combining GeoPackage country boundaries and capital city labels.",
            "tileMatrixSet": "WebMercatorQuad",
            "formats": ["image/png", "application/geo+json", "application/vnd.mapbox-vector-tile"],
