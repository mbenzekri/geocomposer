{
  "name": "geocomposer-db-postgis",
  "private": true,
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "wait": "bash scripts/wait.sh",
    "shell": "docker exec -it myproject-postgis psql -U postgres -d postgres",
    "dump": "bash scripts/dump.sh",
    "restore": "bash scripts/restore.sh",
    "reset": "bash scripts/reset.sh"
  }
}
