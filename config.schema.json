{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocomposer.local/config.schema.json",
  "title": "GeoComposer config",
  "type": "object",
  "additionalProperties": false,
  "required": ["services", "sources", "layers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "services": {
      "$ref": "#/$defs/services"
    },
    "projections": {
      "$ref": "#/$defs/projections"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "styles": {
      "$ref": "#/$defs/styles"
    },
    "layers": {
      "$ref": "#/$defs/layers"
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wms"],
      "properties": {
        "wms": {
          "$ref": "#/$defs/wms"
        },
        "xyz": {
          "$ref": "#/$defs/xyz"
        }
      }
    },
    "wms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "onlineResource": {
          "type": "string"
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 1
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 1
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "xyz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "maxScaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cache": {
          "type": "string"
        },
        "tilesets": {
          "$ref": "#/$defs/tilesets"
        }
      }
    },
    "tilesets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/tileset"
      }
    },
    "tileset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers"],
      "properties": {
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "tileSize": {
          "type": "integer",
          "minimum": 1
        },
        "minZoom": {
          "type": "integer",
          "minimum": 0
        },
        "maxZoom": {
          "type": "integer",
          "minimum": 0
        },
        "cacheControl": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tilesetLayer"
          }
        }
      }
    },
    "tilesetLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer"],
      "properties": {
        "layer": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/projection"
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/geojsonSource"
        },
        {
          "$ref": "#/$defs/gmlSource"
        },
        {
          "$ref": "#/$defs/shpSource"
        },
        {
          "$ref": "#/$defs/gpkgSource"
        },
        {
          "$ref": "#/$defs/memSource"
        }
      ]
    },
    "sourceBase": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "crs": {
          "type": "string"
        }
      }
    },
    "geojsonSource": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "geojson"
            },
            "title": {
              "type": "string"
            },
            "abstract": {
              "type": "string"
            },
            "crs": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            },
            "highWaterMark": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "gmlSource": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "gml"
            },
            "title": {
              "type": "string"
            },
            "abstract": {
              "type": "string"
            },
            "crs": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            },
            "highWaterMark": {
              "type": "integer",
              "minimum": 1
            },
            "featureElementNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "geometryPropertyNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "axisOrder": {
              "enum": ["auto", "xy", "yx"]
            }
          }
        }
      ]
    },
    "shpSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shpPath", "dbfPath"],
      "properties": {
        "type": {
          "const": "shp"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "shpPath": {
          "type": "string"
        },
        "dbfPath": {
          "type": "string"
        },
        "dbfEncoding": {
          "type": "string"
        },
        "highWaterMark": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gpkgSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "const": "gpkg"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "tableName": {
          "type": "string"
        },
        "geometryColumn": {
          "type": "string"
        },
        "primaryKey": {
          "type": "string"
        }
      }
    },
    "memSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": {
          "const": "mem"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/style"
      }
    },
    "style": {
      "oneOf": [
        {
          "$ref": "#/$defs/builtinStyle"
        },
        {
          "$ref": "#/$defs/dynamicStyle"
        }
      ]
    },
    "builtinStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "builtin"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        }
      }
    },
    "dynamicStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "const": "dynamic"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "units": {
              "enum": ["m", "dd"]
            },
            "dotsPerInch": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/layer"
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sourceCrs": {
          "type": "string"
        },
        "extent": {
          "$ref": "#/$defs/bbox"
        },
        "style": {
          "type": "string"
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    }
  }
}
