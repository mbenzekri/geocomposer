{
  "name": "ogc-ol-renderer-poc",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "serve": "tsx src/geo-composer.ts",
    "demo": "tsx src/example/render-demo.ts",
    "demo:styles": "tsx src/example/style-smoke-demo.ts",
    "demo:world": "tsx src/example/render-world-geojson.ts",
    "demo:world:shp": "tsx src/example/render-world-shapefile.ts",
    "demo:world:gml": "tsx src/example/render-world-gml.ts",
    "demo:world:gpkg": "tsx src/example/render-world-geopackage.ts",
    "demo:dynamic-style": "tsx src/example/render-dynamic-style.ts",
    "demo:all": "npm run build && npm run demo:styles && npm run demo && npm run demo:world && npm run demo:world:shp && npm run demo:world:gml && npm run demo:world:gpkg && npm run demo:dynamic-style"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "canvas": "^3.2.0",
    "ol": "^10.6.1",
    "pg": "^8.21.0",
    "pg-cursor": "^2.20.0",
    "proj4": "^2.19.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
