{
  "name": "geo-composer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:typecheck && npm run test:unit",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:file": "npm run test:typecheck && vitest run",
    "test:file:watch": "npm run test:typecheck && vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "tsx src/geo-composer.ts -cc",
    "demo:styles": "tsx src/example/demo-styles.ts",
    "demo:dynstyle": "tsx src/example/demo-dynstyle.ts",
    "demo:all": "npm run build && npm run demo:styles && npm run demo:dynstyle"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "canvas": "^3.2.0",
    "ol": "^10.6.1",
    "oracledb": "^7.0.0",
    "pg": "^8.21.0",
    "pg-cursor": "^2.20.0",
    "proj4": "^2.19.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/oracledb": "^7.0.1",
    "@types/pg": "^8.20.0",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
