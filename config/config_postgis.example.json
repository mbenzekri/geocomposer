{
    "$schema": "./config.schema.json",
    "server": {
        "port": 3000
    },
    "services": {
        "wms": {
            "path": "/wms",
            "title": "GeoComposer PostGIS WMS",
            "abstract": "Minimal WMS server backed by a PostGIS source.",
            "layers": ["roads"]
        }
    },
    "projections": {
        "EPSG:4326": {
            "title": "WGS84"
        },
        "EPSG:3857": {
            "title": "Web Mercator"
        }
    },
    "sources": {
        "postgis-main": {
            "type": "postgis",
            "title": "Roads PostGIS",
            "abstract": "Road network from a PostGIS table.",
            "connection": "$s{GEOCOMPOSER_POSTGIS_URL}",
            "schema": "public",
            "datasets": {
                "roads": "roads"
            },
            "batchSize": 500,
            "extentStrategy": "estimated"
        }
    },
    "layers": {
        "roads": {
            "title": "Roads",
            "abstract": "Roads from PostGIS.",
            "source": "postgis-main",
            "crs": "EPSG:4326",
            "extent": [-180, -90, 180, 90],
            "style": "default"
        }
    }
}
