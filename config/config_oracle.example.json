{
    "$schema": "./config.schema.json",
    "server": {
        "port": 3000
    },
    "services": {
        "wms": {
            "path": "/wms",
            "title": "GeoComposer Oracle WMS",
            "abstract": "Minimal WMS server backed by an Oracle SDO_GEOMETRY source.",
            "layers": ["world-oracle"]
        }
    },
    "crs": {
        "EPSG:4326": {
            "title": "WGS84"
        },
        "EPSG:3857": {
            "title": "Web Mercator"
        }
    },
    "sources": {
        "oracle-main": {
            "type": "oracle",
            "title": "World Oracle",
            "abstract": "World polygons from an Oracle MDSYS.SDO_GEOMETRY table.",
            "connection": {
                "connectionString": "oracle://$s{GEOC_ORACLE_USER|GEOCOMPOSER}:$s{GEOC_ORACLE_PASSWORD|geocomposer}@$s{GEOC_ORACLE_HOST|localhost}:1521/$s{GEOC_ORACLE_SERVICE|XEPDB1}",
                "externalAuth": false,
                "homogeneous": true,
                "poolMin": 0,
                "poolMax": 4,
                "poolIncrement": 1,
                "poolTimeout": 60,
                "queueTimeout": 30000,
                "stmtCacheSize": 30,
                "callTimeout": 30000
            },
            "schema": "$s{GEOC_ORACLE_SCHEMA|GEOCOMPOSER}",
            "datasets": {
                "world": {
                    "tableName": "WORLD",
                    "geometryColumn": "GEOM",
                    "primaryKey": "ID",
                    "srid": 4326,
                    "properties": ["NAME", "LABEL_X", "LABEL_Y"]
                }
            },
            "batchSize": 500,
            "extentStrategy": "metadata"
        }
    },
    "layers": {
        "world-oracle": {
            "title": "World Oracle",
            "abstract": "World polygons from Oracle.",
            "source": "oracle-main",
            "dataset": "world",
            "crs": "EPSG:4326",
            "extent": [-180, -90, 180, 90],
            "style": "default"
        }
    }
}
