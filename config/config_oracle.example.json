{
    "$schema": "./config.schema.json",
    "server": {
        "port": 3000
    },
    "services": {
        "wms": {
            "path": "/wms",
            "title": "GeoComposer Oracle WMS",
            "abstract": "Minimal WMS server backed by an Oracle SDO_GEOMETRY source.",
            "layers": ["world-oracle"]
        }
    },
    "projections": {
        "EPSG:4326": {
            "title": "WGS84"
        },
        "EPSG:3857": {
            "title": "Web Mercator"
        }
    },
    "sources": {
        "oracle-main": {
            "type": "oracle",
            "title": "World Oracle",
            "abstract": "World polygons from an Oracle MDSYS.SDO_GEOMETRY table.",
            "connection": "GEOCOMPOSER/geocomposer@localhost:1521/XEPDB1",
            "schema": "GEOCOMPOSER",
            "datasets": {
                "world": "WORLD"
            },
            "batchSize": 500,
            "extentStrategy": "metadata"
        }
    },
    "layers": {
        "world-oracle": {
            "title": "World Oracle",
            "abstract": "World polygons from Oracle.",
            "source": "oracle-main",
            "dataset": "world",
            "crs": "EPSG:4326",
            "extent": [-180, -90, 180, 90],
            "style": "default"
        }
    }
}
